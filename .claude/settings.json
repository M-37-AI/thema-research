{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(python3 tools/*)",
      "Bash(mkdir -p runs/*)",
      "Bash(date -Iseconds)",
      "Bash(date +%F)",
      "Edit(/runs/**)",
      "Edit(/data/**)"
    ]
  },
  "hooks": {
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/bin/python3\" \"${CLAUDE_PROJECT_DIR}/tools/gate_create.py\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/bin/python3\" \"${CLAUDE_PROJECT_DIR}/tools/gate.py\""
          }
        ]
      }
    ]
  }
}
